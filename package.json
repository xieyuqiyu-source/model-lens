{
  "name": "model-lens",
  "version": "0.2.24",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "package": "tauri build --bundles app",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "tsc -b && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^0.468.0",
    "@fontsource/inter": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
